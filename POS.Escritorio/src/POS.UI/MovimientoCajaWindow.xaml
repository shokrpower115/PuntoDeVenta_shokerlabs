<Window x:Class="POS.UI.MovimientoCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimiento de Caja" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Título -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Label "Tipo:" -->
            <RowDefinition Height="Auto"/>
            <!-- 2: RadioButtons -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Label "Razón:" -->
            <RowDefinition Height="Auto"/>
            <!-- 4: ComboBox Razón -->
            <RowDefinition Height="Auto"/>
            <!-- 5: TextBox "Otro" -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Label "Monto:" -->
            <RowDefinition Height="Auto"/>
            <!-- 7: TextBox Monto -->
            <RowDefinition Height="Auto"/>
            <!-- 8: Label "Confirma tu usuario:" -->
            <RowDefinition Height="Auto"/>
            <!-- 9: TextBox Usuario -->
            <RowDefinition Height="Auto"/>
            <!-- 10: Label "Confirma tu contraseña:" -->
            <RowDefinition Height="Auto"/>
            <!-- 11: PasswordBox -->
            <RowDefinition Height="Auto"/>
            <!-- 12: Mensaje de error -->
            <RowDefinition Height="Auto"/>
            <!-- 13: Botones -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Movimiento de Caja" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Tipo:" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <RadioButton Content="Retiro" GroupName="Tipo" Margin="0,0,20,0"
                         IsChecked="{Binding TipoSeleccionado, Converter={StaticResource EnumABooleanoConverter}, ConverterParameter=Retiro}"/>
            <RadioButton Content="Entrada" GroupName="Tipo"
                         IsChecked="{Binding TipoSeleccionado, Converter={StaticResource EnumABooleanoConverter}, ConverterParameter=Entrada}"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Razón:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4" ItemsSource="{Binding RazonesDisponibles}" SelectedItem="{Binding RazonSeleccionada}"
                  DisplayMemberPath="Nombre" Padding="6" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Text="Describe el motivo:"
           Visibility="{Binding RequiereDescripcionOtro, Converter={StaticResource BooleanoAVisibilidadConverter}}"
           Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" Text="{Binding DescripcionOtro, UpdateSourceTrigger=PropertyChanged}"
         Visibility="{Binding RequiereDescripcionOtro, Converter={StaticResource BooleanoAVisibilidadConverter}}"
         Padding="6" Margin="0,20,0,15"/>

        <TextBlock Grid.Row="6" Text="Monto:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="7" Text="{Binding Monto, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalSeguroConverter}}"
         FontSize="16" Padding="6" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="8" Text="Confirma tu usuario:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="9" Text="{Binding NombreUsuarioConfirmacion, UpdateSourceTrigger=PropertyChanged}"
         Padding="6" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="10" Text="Confirma tu contraseña:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="11" Padding="6" Margin="0,0,0,10"
             PasswordChanged="PasswordBox_PasswordChanged"/>

        <TextBlock Grid.Row="12" Text="{Binding MensajeError}" Foreground="{StaticResource BrushRojoPrimario}"
           TextWrapping="Wrap"/>

        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="100" Height="40" Margin="0,0,10,0"/>
            <Button Content="Confirmar movimiento" Command="{Binding ConfirmarCommand}" Style="{StaticResource BotonAccento}"
            Width="170" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
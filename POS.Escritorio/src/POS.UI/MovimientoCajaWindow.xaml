<Window x:Class="POS.UI.MovimientoCajaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimiento de caja" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource VentanaBase}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="28">
        <TextBlock Text="Movimiento de caja" Style="{StaticResource TextoTitulo}"/>
        <TextBlock Text="Registra dinero que entra o sale de la caja sin ser una venta." Style="{StaticResource TextoSecundario}"
                   Margin="0,4,0,22"/>

        <TextBlock Text="Tipo de movimiento" Style="{StaticResource TextoEtiqueta}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Content="Retiro" GroupName="Tipo" Style="{StaticResource OpcionSegmento}"
                         IsChecked="{Binding TipoSeleccionado, Converter={StaticResource EnumABooleanoConverter}, ConverterParameter=Retiro}"/>
            <RadioButton Content="Entrada" GroupName="Tipo" Style="{StaticResource OpcionSegmento}"
                         IsChecked="{Binding TipoSeleccionado, Converter={StaticResource EnumABooleanoConverter}, ConverterParameter=Entrada}"/>
        </StackPanel>

        <TextBlock Text="Razón" Style="{StaticResource TextoEtiqueta}"/>
        <ComboBox ItemsSource="{Binding RazonesDisponibles}" SelectedItem="{Binding RazonSeleccionada}"
                  DisplayMemberPath="Nombre" Margin="0,0,0,16"/>

        <StackPanel Visibility="{Binding RequiereDescripcionOtro, Converter={StaticResource BooleanoAVisibilidadConverter}}">
            <TextBlock Text="Describe el motivo" Style="{StaticResource TextoEtiqueta}"/>
            <TextBox Text="{Binding DescripcionOtro, UpdateSourceTrigger=PropertyChanged}" Tag="Ej. Pago a proveedor de garrafones"
                     Margin="0,0,0,16"/>
        </StackPanel>

        <TextBlock Text="Monto" Style="{StaticResource TextoEtiqueta}"/>
        <TextBox Text="{Binding Monto, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecimalSeguroConverter}}"
                 Style="{StaticResource CampoMonto}" Margin="0,0,0,20"/>

        <Border Background="{StaticResource BrushSuperficieAlt}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE72E;" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,8,0"/>
                    <TextBlock Text="Confirma con tu usuario y contraseña" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBox Text="{Binding NombreUsuarioConfirmacion, UpdateSourceTrigger=PropertyChanged}" Tag="Usuario" Margin="0,0,0,10"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AvisoError}" Margin="0,0,0,16"
                Visibility="{Binding MensajeError, Converter={StaticResource TextoNoVacioAVisibilidad}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrushPeligro}" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" MinWidth="110" Height="44" Margin="0,0,10,0"/>
            <Button Content="Registrar movimiento" Command="{Binding ConfirmarCommand}" Style="{StaticResource BotonPrimario}"
                    MinWidth="190" Height="44"/>
        </StackPanel>
    </StackPanel>
</Window>

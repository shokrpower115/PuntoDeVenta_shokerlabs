<Application x:Class="POS.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:POS.UI.ViewModels"
             xmlns:views="clr-namespace:POS.UI.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Cada vez que PantallaActual sea de este tipo de ViewModel,
                 WPF renderiza automáticamente la Vista asociada. -->
            <DataTemplate DataType="{x:Type vm:VentaViewModel}">
                <views:VentaView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InventarioViewModel}">
                <views:InventarioView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CorteCajaViewModel}">
                <views:CorteCajaView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdministradorViewModel}">
                <views:AdministradorView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

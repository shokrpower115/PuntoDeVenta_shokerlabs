<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        SISTEMA DE DISEÑO DEL POS
        Las reglas de uso están en docs/guia-de-estilo-ui.md. Resumen:
        - Neutros fijos (fondo, superficies, texto) + UN color de marca configurable por negocio.
        - Todo lo que use el color de marca va con DynamicResource: Marca.Aplicar() lo
          reemplaza al arrancar con el color que el negocio eligió en su configuración.
        - Las vistas no definen colores ni tamaños sueltos: usan estos estilos.
    -->

    <!-- ===== Neutros (fijos) ===== -->
    <Color x:Key="ColorFondo">#FFF3F4F6</Color>
    <Color x:Key="ColorSuperficie">#FFFFFFFF</Color>
    <Color x:Key="ColorSuperficieAlt">#FFF9FAFB</Color>
    <Color x:Key="ColorBorde">#FFE5E7EB</Color>
    <Color x:Key="ColorBordeFuerte">#FFD1D5DB</Color>
    <Color x:Key="ColorTexto">#FF111827</Color>
    <Color x:Key="ColorTextoSecundario">#FF6B7280</Color>
    <Color x:Key="ColorTextoTenue">#FF9CA3AF</Color>
    <Color x:Key="ColorTextoInverso">#FFFFFFFF</Color>
    <Color x:Key="ColorMenu">#FF111827</Color>
    <Color x:Key="ColorMenuTexto">#FFD1D5DB</Color>

    <!-- ===== Estados (fijos: significan lo mismo en cualquier negocio) ===== -->
    <Color x:Key="ColorExito">#FF16A34A</Color>
    <Color x:Key="ColorExitoSuave">#FFDCFCE7</Color>
    <Color x:Key="ColorPeligro">#FFDC2626</Color>
    <Color x:Key="ColorPeligroSuave">#FFFEE2E2</Color>
    <Color x:Key="ColorAdvertencia">#FFB45309</Color>
    <Color x:Key="ColorAdvertenciaSuave">#FFFEF3C7</Color>

    <SolidColorBrush x:Key="BrushFondo" Color="{StaticResource ColorFondo}"/>
    <SolidColorBrush x:Key="BrushSuperficie" Color="{StaticResource ColorSuperficie}"/>
    <SolidColorBrush x:Key="BrushSuperficieAlt" Color="{StaticResource ColorSuperficieAlt}"/>
    <SolidColorBrush x:Key="BrushBorde" Color="{StaticResource ColorBorde}"/>
    <SolidColorBrush x:Key="BrushBordeFuerte" Color="{StaticResource ColorBordeFuerte}"/>
    <SolidColorBrush x:Key="BrushTexto" Color="{StaticResource ColorTexto}"/>
    <SolidColorBrush x:Key="BrushTextoSecundario" Color="{StaticResource ColorTextoSecundario}"/>
    <SolidColorBrush x:Key="BrushTextoTenue" Color="{StaticResource ColorTextoTenue}"/>
    <SolidColorBrush x:Key="BrushTextoInverso" Color="{StaticResource ColorTextoInverso}"/>
    <SolidColorBrush x:Key="BrushMenu" Color="{StaticResource ColorMenu}"/>
    <SolidColorBrush x:Key="BrushMenuTexto" Color="{StaticResource ColorMenuTexto}"/>
    <SolidColorBrush x:Key="BrushExito" Color="{StaticResource ColorExito}"/>
    <SolidColorBrush x:Key="BrushExitoSuave" Color="{StaticResource ColorExitoSuave}"/>
    <SolidColorBrush x:Key="BrushPeligro" Color="{StaticResource ColorPeligro}"/>
    <SolidColorBrush x:Key="BrushPeligroSuave" Color="{StaticResource ColorPeligroSuave}"/>
    <SolidColorBrush x:Key="BrushAdvertencia" Color="{StaticResource ColorAdvertencia}"/>
    <SolidColorBrush x:Key="BrushAdvertenciaSuave" Color="{StaticResource ColorAdvertenciaSuave}"/>

    <!-- ===== Marca (valores por defecto; Marca.Aplicar los reemplaza en tiempo de ejecución) ===== -->
    <SolidColorBrush x:Key="BrushPrimario" Color="#FF2563EB"/>
    <SolidColorBrush x:Key="BrushPrimarioOscuro" Color="#FF1E4FC0"/>
    <SolidColorBrush x:Key="BrushPrimarioSuave" Color="#FFE3ECFD"/>
    <SolidColorBrush x:Key="BrushPrimarioTexto" Color="#FFFFFFFF"/>
    <sys:String x:Key="NombreNegocio">Punto de Venta</sys:String>
    <sys:String x:Key="InicialesNegocio">PV</sys:String>
    <x:Null x:Key="LogoNegocio"/>
    <Visibility x:Key="VisibilidadLogo">Collapsed</Visibility>
    <Visibility x:Key="VisibilidadIniciales">Visible</Visibility>

    <!-- ===== Tipografía ===== -->
    <FontFamily x:Key="FuenteBase">Segoe UI</FontFamily>
    <!-- Íconos del sistema (incluidos en Windows 10/11). Con respaldo a Segoe UI para símbolos como "$". -->
    <FontFamily x:Key="FuenteIconos">Segoe MDL2 Assets, Segoe UI</FontFamily>

    <Style x:Key="VentanaBase" TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="{StaticResource BrushFondo}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="TextoTitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
    </Style>

    <Style x:Key="TextoSubtitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
    </Style>

    <Style x:Key="TextoEtiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="TextoSecundario" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Montos protagonistas (total de la venta, cambio): números tabulares y grandes. -->
    <Style x:Key="TextoMonto" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <Style x:Key="Icono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteIconos}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Contenedores ===== -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Avisos en línea: se ocultan solos cuando el texto está vacío (ver TextoNoVacioAVisibilidad). -->
    <Style x:Key="AvisoAdvertencia" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushAdvertenciaSuave}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="AvisoError" TargetType="Border" BasedOn="{StaticResource AvisoAdvertencia}">
        <Setter Property="Background" Value="{StaticResource BrushPeligroSuave}"/>
    </Style>
    <Style x:Key="AvisoExito" TargetType="Border" BasedOn="{StaticResource AvisoAdvertencia}">
        <Setter Property="Background" Value="{StaticResource BrushExitoSuave}"/>
    </Style>

    <!-- ===== Botones =====
         Una sola plantilla: el hover/press es una capa oscura semitransparente, así funciona
         con cualquier color de fondo (incluido el color de marca de cada negocio). -->
    <ControlTemplate x:Key="PlantillaBoton" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
            <Border x:Name="Capa" Background="#FF000000" Opacity="0" CornerRadius="8"/>
            <Border x:Name="Foco" BorderBrush="{StaticResource BrushTexto}" BorderThickness="2" CornerRadius="8" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Capa" Property="Opacity" Value="0.08"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Capa" Property="Opacity" Value="0.16"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Foco" Property="Opacity" Value="0.6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PlantillaBoton}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Acción principal de una pantalla (máximo una por pantalla). -->
    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{DynamicResource BrushPrimario}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushPrimarioTexto}"/>
    </Style>

    <!-- Acciones secundarias y "Cancelar". -->
    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeFuerte}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Cobrar / confirmar dinero: siempre verde, sin importar el color de marca. -->
    <Style x:Key="BotonExito" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource BrushExito}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoInverso}"/>
    </Style>

    <!-- Acciones destructivas o irreversibles (desactivar, cerrar sesión). -->
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource BrushPeligro}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextoInverso}"/>
    </Style>

    <!-- Botón sin fondo, para acciones de bajo peso (Volver, íconos dentro de tablas). -->
    <Style x:Key="BotonFantasma" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- Botón cuadrado de ícono (+, −, eliminar en el carrito). -->
    <Style x:Key="BotonIcono" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource FuenteIconos}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Cualquier botón sin estilo explícito se ve como secundario. -->
    <Style TargetType="Button" BasedOn="{StaticResource BotonSecundario}"/>

    <!-- ===== Menú lateral ===== -->
    <Style x:Key="ItemMenu" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushMenuTexto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="12,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Fondo" Background="Transparent" CornerRadius="8"/>
                        <Border x:Name="Indicador" Width="4" Height="22" HorizontalAlignment="Left" CornerRadius="2"
                                Background="{DynamicResource BrushPrimario}" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="18,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icono}" Margin="0,0,14,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="#26FFFFFF"/>
                            <Setter TargetName="Indicador" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextoInverso}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Campos de captura ===== -->
    <!-- El texto de ayuda (placeholder) se pone en Tag: <TextBox Tag="Buscar producto..."/> -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeFuerte}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <!-- El TextBox ya aplica su Padding al área de texto; el marcador lo replica (+2 px del cursor). -->
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Border Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <TextBlock x:Name="Marcador" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource BrushTextoTenue}" Padding="2,0,0,0"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Marcador" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource BrushTextoTenue}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource BrushPrimario}"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource BrushSuperficieAlt}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo para montos: alineado a la derecha y con letra más grande. -->
    <Style x:Key="CampoMonto" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBordeFuerte}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource BrushTextoTenue}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource BrushPrimario}"/>
                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fondo" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BrushSuperficieAlt}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushPrimarioSuave}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Borde" Background="{StaticResource BrushSuperficie}" BorderBrush="{StaticResource BrushBordeFuerte}"
                                            BorderThickness="1" CornerRadius="6">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FuenteIconos}" FontSize="10"
                                                   Foreground="{StaticResource BrushTextoSecundario}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource BrushTextoTenue}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource BrushPrimario}"/>
                                            <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                            <Border Background="{StaticResource BrushSuperficie}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="1"
                                    CornerRadius="6" Margin="0,4,0,0" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
    </Style>

    <!-- Elección entre pocas opciones excluyentes (Retiro / Entrada). -->
    <Style x:Key="OpcionSegmento" TargetType="RadioButton">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fondo" Background="{StaticResource BrushSuperficie}" BorderBrush="{StaticResource BrushBordeFuerte}"
                            BorderThickness="1" CornerRadius="8" Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushPrimarioSuave}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource BrushPrimario}"/>
                            <Setter TargetName="Fondo" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Logo del negocio o, si no hay logo, sus iniciales sobre el color de marca. -->
    <Style x:Key="InsigniaNegocio" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushPrimario}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
    </Style>

    <!-- ===== Tablas ===== -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource BrushTextoSecundario}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{StaticResource BrushSuperficieAlt}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,0,0,1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSuperficieAlt}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource BrushPrimarioSuave}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeight" Value="44"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorde}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <!-- ===== Opciones tipo mosaico (métodos de pago, colores) ===== -->
    <Style x:Key="OpcionMosaico" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Fondo" Background="{StaticResource BrushSuperficie}" CornerRadius="10"
                            BorderThickness="2" BorderBrush="{StaticResource BrushBorde}" Padding="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource BrushBordeFuerte}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource BrushPrimarioSuave}"/>
                            <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource BrushPrimario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListaMosaicos" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource OpcionMosaico}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

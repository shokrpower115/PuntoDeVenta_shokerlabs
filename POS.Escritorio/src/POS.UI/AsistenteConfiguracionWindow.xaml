<Window x:Class="POS.UI.AsistenteConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:POS.UI.Views"
        Title="Bienvenido — Configuración inicial" Width="1040" Height="780" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" Style="{StaticResource VentanaBase}">
    <!-- Primer arranque: antes del login se capturan los datos del negocio. -->
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AvisoAdvertencia}" Background="{DynamicResource BrushPrimarioSuave}" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icono}" Text="&#xE946;" Margin="0,0,10,0" Foreground="{DynamicResource BrushPrimario}"/>
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                    <Run FontWeight="SemiBold" Text="Primer arranque."/>
                    <Run Text="Configura tu negocio. Después inicia sesión con el usuario"/>
                    <Run FontWeight="SemiBold" Text="admin"/>
                    <Run Text="y contraseña"/>
                    <Run FontWeight="SemiBold" Text="admin"/><Run Text="; se te pedirá cambiarla."/>
                </TextBlock>
            </StackPanel>
        </Border>

        <views:ConfiguracionNegocioView Grid.Row="1"/>
    </Grid>
</Window>

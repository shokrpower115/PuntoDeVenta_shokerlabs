<Window x:Class="POS.UI.CobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar" Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushFondo}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding TotalVenta, StringFormat='Total de la venta: {0:C}'}"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Tipo de pago:" FontWeight="Bold" Margin="0,0,0,8"/>

        <ListBox Grid.Row="2" ItemsSource="{Binding MetodosPago}" SelectedItem="{Binding MetodoPagoSeleccionado}"
                 BorderThickness="0" Background="Transparent" Margin="0,0,0,15">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Nombre}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="100"/>
                    <Setter Property="Height" Value="70"/>
                    <Setter Property="Margin" Value="0,0,10,10"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Fondo" Background="{StaticResource BrushGrisClaro}" CornerRadius="6"
                                        BorderThickness="2" BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BrushAzulPrimario}"/>
                                        <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource BrushAzulOscuro}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Grid.Row="3" Text="¿Con cuánto paga el cliente?" Margin="0,0,0,5"/>
        <TextBox Grid.Row="4" Text="{Binding MontoPagado, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding RequiereMontoPagado}" FontSize="16" Padding="6" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="5" Text="{Binding Cambio, StringFormat='Feria a regresar: {0:C}'}"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Text="{Binding MensajeError}" Foreground="{StaticResource BrushRojoPrimario}"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="110" Height="40" Margin="0,0,10,0"/>
            <Button Content="Confirmar cobro" Command="{Binding ConfirmarCommand}" Style="{StaticResource BotonAccento}"
                    Width="160" Height="40"/>
        </StackPanel>
    </Grid>
</Window>
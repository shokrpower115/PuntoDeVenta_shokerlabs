<Window x:Class="POS.UI.CobroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource VentanaBase}"
        FocusManager.FocusedElement="{Binding ElementName=TxtMonto}">
    <!-- Enter confirma, Esc cancela. -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding ConfirmarCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}"/>
    </Window.InputBindings>

    <StackPanel Margin="28">
        <!-- Total a cobrar -->
        <Border Background="{StaticResource BrushMenu}" CornerRadius="10" Padding="20,16" Margin="0,0,0,24">
            <Grid>
                <TextBlock Text="Total a cobrar" Foreground="{StaticResource BrushMenuTexto}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalVenta, StringFormat=C}" Style="{StaticResource TextoMonto}"
                           Foreground="{StaticResource BrushTextoInverso}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <TextBlock Text="Forma de pago" Style="{StaticResource TextoEtiqueta}"/>
        <ListBox ItemsSource="{Binding MetodosPago}" SelectedItem="{Binding MetodoPagoSeleccionado}"
                 Style="{StaticResource ListaMosaicos}" Margin="0,0,-10,14">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="96" Height="62" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tipo, Converter={StaticResource TipoMetodoPagoAIcono}}"
                                   FontSize="20" HorizontalAlignment="Center" Margin="0,4,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icono}">
                                    <Style.Triggers>
                                        <!-- "$" se dibuja con la fuente de texto: la de íconos tiene otro glifo en ese código. -->
                                        <DataTrigger Binding="{Binding Tipo}" Value="Efectivo">
                                            <Setter Property="FontFamily" Value="{StaticResource FuenteBase}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Nombre}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Solo efectivo: con cuánto paga + atajos de billetes -->
        <StackPanel Visibility="{Binding RequiereMontoPagado, Converter={StaticResource BooleanoAVisibilidadConverter}}">
            <TextBlock Text="¿Con cuánto paga el cliente?" Style="{StaticResource TextoEtiqueta}"/>
            <TextBox x:Name="TxtMonto" Style="{StaticResource CampoMonto}" Margin="0,0,0,10"
                     Text="{Binding MontoPagado, UpdateSourceTrigger=PropertyChanged}"/>
            <ItemsControl ItemsSource="{Binding MontosRapidos}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" ContentStringFormat="C" Margin="0,0,8,0" MinWidth="80" Focusable="False"
                                Command="{Binding DataContext.MontoRapidoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource BrushExitoSuave}" CornerRadius="10" Padding="20,14" Margin="0,0,0,16">
                <Grid>
                    <TextBlock Text="Cambio a entregar" Foreground="{StaticResource BrushExito}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Cambio, StringFormat=C}" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrushExito}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource AvisoError}" Margin="0,0,0,16"
                Visibility="{Binding MensajeError, Converter={StaticResource TextoNoVacioAVisibilidad}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrushPeligro}" TextWrapping="Wrap"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar (Esc)" Command="{Binding CancelarCommand}" Height="50"/>
            <Button Grid.Column="2" Content="Confirmar cobro (Enter)" Command="{Binding ConfirmarCommand}"
                    Style="{StaticResource BotonExito}" Height="50" FontSize="16"/>
        </Grid>
    </StackPanel>
</Window>

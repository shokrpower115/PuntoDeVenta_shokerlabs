<UserControl x:Class="POS.UI.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Inventario" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
        <Button Content="Recargar" Command="{Binding RecargarCommand}" Style="{StaticResource BotonPrimario}"
                HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,10"/>

        <DataGrid ItemsSource="{Binding Productos}" AutoGenerateColumns="False" Height="450" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Código de barras" Binding="{Binding CodigoBarras}" Width="150"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding StockPorSucursal[0].Stock}"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>

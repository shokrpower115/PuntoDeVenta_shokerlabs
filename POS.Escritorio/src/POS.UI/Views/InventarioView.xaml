<UserControl x:Class="POS.UI.Views.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Inventario" Style="{StaticResource TextoTitulo}"/>
            <Button Content="Actualizar" Command="{Binding RecargarCommand}" HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid ItemsSource="{Binding Productos}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoBarras}" Width="150"/>
                    <DataGridTextColumn Header="PRECIO" Binding="{Binding Precio, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockPorSucursal[0].Stock, FallbackValue=0}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

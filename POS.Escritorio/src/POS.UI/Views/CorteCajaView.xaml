<UserControl x:Class="POS.UI.Views.CorteCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel MaxWidth="380" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Corte de Caja" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="Efectivo en caja (conteo físico):" Margin="0,0,0,5"/>
            <TextBox Text="{Binding EfectivoFinal, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16" Padding="6" Margin="0,0,0,20"/>

            <TextBlock Text="Confirma tu usuario:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding NombreUsuarioConfirmacion, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" Margin="0,0,0,15"/>

            <TextBlock Text="Confirma tu contraseña:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Padding="6" Margin="0,0,0,15"
                         PasswordChanged="PasswordBox_PasswordChanged"/>

            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrushRojoPrimario}"
                       TextWrapping="Wrap" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <Button Content="Realizar corte" Command="{Binding RealizarCorteCommand}"
                    Style="{StaticResource BotonAccento}" Height="48" FontSize="16"/>
        </StackPanel>
    </Grid>
</UserControl>
<UserControl x:Class="POS.UI.Views.CorteCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="400">
        <TextBlock Text="Corte de Caja" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Efectivo inicial:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding EfectivoInicial}" Margin="0,0,0,10" Padding="5"/>
        <Button Content="Abrir turno" Command="{Binding AbrirTurnoCommand}" Style="{StaticResource BotonPrimario}"
                Padding="10,5" Margin="0,0,0,20"/>

        <TextBlock Text="{Binding TotalVentasTurno, StringFormat='Total vendido en el turno: {0:C}'}"
                   FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Efectivo final (conteo físico):" Margin="0,0,0,5"/>
        <TextBox Text="{Binding EfectivoFinal}" Margin="0,0,0,10" Padding="5"/>
        <Button Content="Cerrar turno" Command="{Binding CerrarTurnoCommand}" Style="{StaticResource BotonAccento}"
                Padding="10,5"/>
    </StackPanel>
</UserControl>

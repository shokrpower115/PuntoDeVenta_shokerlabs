<UserControl x:Class="POS.UI.Views.CorteCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Conteo ciego (RN-CORTE-03): el cajero captura lo que contó SIN ver el efectivo esperado;
         la diferencia aparece hasta el ticket del corte. -->
    <StackPanel>
        <TextBlock Text="Corte de caja" Style="{StaticResource TextoTitulo}"/>
        <TextBlock Text="Cuenta todo el efectivo del cajón y captura el total. Al confirmar se cierra el turno y se imprime el corte."
                   Style="{StaticResource TextoSecundario}" Margin="0,4,0,20"/>

        <!-- Datos del turno -->
        <Border Background="{StaticResource BrushSuperficieAlt}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Abierto por" Style="{StaticResource TextoSecundario}"/>
                    <TextBlock Text="{Binding TurnoActual.Usuario.NombreCompleto, FallbackValue='—'}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Desde" Style="{StaticResource TextoSecundario}"/>
                    <TextBlock Text="{Binding TurnoActual.FechaApertura, StringFormat='dd/MM HH:mm', FallbackValue='—'}" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fondo inicial" Style="{StaticResource TextoSecundario}"/>
                    <TextBlock Text="{Binding TurnoActual.EfectivoInicial, StringFormat=C, FallbackValue='—'}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Efectivo contado en caja" Style="{StaticResource TextoEtiqueta}"/>
        <TextBox Text="{Binding EfectivoFinal, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource CampoMonto}" Margin="0,0,0,20"/>

        <Border Background="{StaticResource BrushSuperficieAlt}" BorderBrush="{StaticResource BrushBorde}" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE72E;" Foreground="{StaticResource BrushTextoSecundario}" Margin="0,0,8,0"/>
                    <TextBlock Text="Autoriza el corte" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Quien abrió el turno o un administrador." Style="{StaticResource TextoSecundario}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding NombreUsuarioConfirmacion, UpdateSourceTrigger=PropertyChanged}" Tag="Usuario" Margin="0,0,0,10"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource AvisoError}" Margin="0,0,0,16"
                Visibility="{Binding MensajeError, Converter={StaticResource TextoNoVacioAVisibilidad}}">
            <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrushPeligro}" TextWrapping="Wrap"/>
        </Border>

        <Button Content="Realizar corte y cerrar turno" Command="{Binding RealizarCorteCommand}"
                Style="{StaticResource BotonPrimario}" Height="50" FontSize="16"/>
    </StackPanel>
</UserControl>

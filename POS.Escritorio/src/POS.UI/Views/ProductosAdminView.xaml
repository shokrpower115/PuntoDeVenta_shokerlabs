<UserControl x:Class="POS.UI.Views.ProductosAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        

        <!-- Columna izquierda: formulario de alta -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <Button Content="← Volver" Command="{Binding VolverCommand}" Style="{StaticResource BotonPrimario}"
                    HorizontalAlignment="Left" Padding="15,5" Margin="0,0,0,15"/>
            <TextBlock Text="Nuevo producto" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Nombre:" Margin="0,5,0,3"/>
            <TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <TextBlock Text="Código de barras (opcional):" Margin="0,10,0,3"/>
            <TextBox Text="{Binding NuevoCodigoBarras, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <TextBlock Text="Precio:" Margin="0,10,0,3"/>
            <TextBox Text="{Binding NuevoPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <TextBlock Text="Stock inicial por sucursal:" FontWeight="Bold" Margin="0,15,0,5"/>

            <TextBlock Text="Centro:" Margin="0,5,0,3"/>
            <TextBox Text="{Binding NuevoStockCentro, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <TextBlock Text="Norte:" Margin="0,10,0,3"/>
            <TextBox Text="{Binding NuevoStockNorte, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <TextBlock Text="Sur:" Margin="0,10,0,3"/>
            <TextBox Text="{Binding NuevoStockSur, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <Button Content="Crear producto" Command="{Binding CrearProductoCommand}" Style="{StaticResource BotonAccento}"
                    Height="40" Margin="0,15,0,0"/>

            <TextBlock Text="{Binding Mensaje}" Foreground="DarkOrange" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Columna derecha: catálogo completo -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Catálogo completo" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Productos}"
                      SelectedItem="{Binding ProductoSeleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="120"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Editar producto seleccionado" Command="{Binding EditarProductoCommand}"
                    Style="{StaticResource BotonPrimario}" Height="40" Padding="15,0" Margin="0,0,10,0"/>
                <Button Content="Eliminar producto seleccionado" Command="{Binding EliminarProductoCommand}"
                    Style="{StaticResource BotonAccento}" Height="40" Padding="15,0"/>
            </StackPanel>

            <Border Grid.Row="3" Visibility="{Binding EditandoProducto, Converter={StaticResource BooleanoAVisibilidadConverter}}"
                            Background="{StaticResource BrushGrisClaro}" CornerRadius="6" Padding="15" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="Editando producto" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Nombre:" Margin="0,5,0,3"/>
                    <TextBox Text="{Binding EditNombre, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

                    <TextBlock Text="Código de barras:" Margin="0,10,0,3"/>
                    <TextBox Text="{Binding EditCodigoBarras, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

                    <TextBlock Text="Precio:" Margin="0,10,0,3"/>
                    <TextBox Text="{Binding EditPrecio, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

                    <TextBlock Text="Stock por sucursal:" FontWeight="Bold" Margin="0,15,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Centro:"/>
                            <TextBox Text="{Binding EditStockCentro, UpdateSourceTrigger=PropertyChanged}" Padding="5" Width="80"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Norte:"/>
                            <TextBox Text="{Binding EditStockNorte, UpdateSourceTrigger=PropertyChanged}" Padding="5" Width="80"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Sur:"/>
                            <TextBox Text="{Binding EditStockSur, UpdateSourceTrigger=PropertyChanged}" Padding="5" Width="80"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="Guardar cambios" Command="{Binding GuardarEdicionCommand}"
                    Style="{StaticResource BotonAccento}" Padding="15,8" Margin="0,0,10,0"/>
                        <Button Content="Cancelar" Command="{Binding CancelarEdicionCommand}" Padding="15,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
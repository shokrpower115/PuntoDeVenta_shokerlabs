<UserControl x:Class="POS.UI.Views.AdministradorMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Administrador" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <Button Content="Productos" Command="{Binding IrAProductosCommand}" Style="{StaticResource BotonPrimario}"
                Height="60" Width="250" HorizontalAlignment="Left" Margin="0,0,0,10" FontSize="16"/>

        <Button Content="Usuarios" Command="{Binding IrAUsuariosCommand}" Style="{StaticResource BotonPrimario}"
                Height="60" Width="250" HorizontalAlignment="Left" FontSize="16"/>
    </StackPanel>
</UserControl>
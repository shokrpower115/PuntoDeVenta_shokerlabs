<UserControl x:Class="POS.UI.Views.VentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Espacio superior para que los botones resalten -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de acciones rápidas -->
            <RowDefinition Height="*"/>
            <!-- Contenido de venta (lo que ya tienes) -->
        </Grid.RowDefinitions>

        <!-- Barra de acciones rápidas (más separación superior y botones más grandes) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,24,0,24" HorizontalAlignment="Left" VerticalAlignment="Center" >
            <Button Content="Corte de Caja" Command="{Binding AbrirCorteCajaCommand}" Style="{StaticResource BotonPrimario}"
                    Height="54" FontSize="16" MinWidth="160" Padding="15,8" Margin="0,0,12,0"/>
            <Button Content="Retiro de Efectivo" Command="{Binding AbrirRetiroEfectivoCommand}" Style="{StaticResource BotonPrimario}"
                    Height="54" FontSize="16" MinWidth="160" Padding="15,8" Margin="0,0,12,0"/>
            <Button Content="Cancelación de Producto" Style="{StaticResource BotonPrimario}"
                    Height="54" FontSize="16" MinWidth="200" Padding="15,8" IsEnabled="False"/>
            <!-- "Cancelación de Producto" queda deshabilitado por ahora -->
        </StackPanel>

        <!-- Contenido de venta: el Grid de 2 columnas que ya tenías -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: catálogo de productos -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título "Productos" -->
                    <RowDefinition Height="2*"/>
                    <!-- DataGrid de productos -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                    <RowDefinition Height="Auto"/>
                    <!-- Mensaje -->
                    <RowDefinition Height="Auto"/>
                    <!-- Título "Disponibilidad..." -->
                    <RowDefinition Height="1*"/>
                    <!-- DataGrid de disponibilidad -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Productos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ProductosDisponibles}"
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C}" Width="80"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockPorSucursal[0].Stock}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Agregar al carrito" Command="{Binding AgregarAlCarritoCommand}" Style="{StaticResource BotonPrimario}"
                            Height="40" FontSize="14" Padding="10,6" Margin="0,0,10,0"/>
                    <Button Content="Ver en otras sucursales" Command="{Binding ConsultarOtrasSucursalesCommand}" Style="{StaticResource BotonPrimario}"
                            Height="40" FontSize="14" Padding="10,6"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{Binding Mensaje}" Foreground="DarkOrange" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="4" Text="Disponibilidad en otras sucursales:" FontWeight="Bold" Margin="0,15,0,5"/>

                <DataGrid Grid.Row="5"
                          ItemsSource="{Binding DisponibilidadOtrasSucursales}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sucursal" Binding="{Binding NombreSucursal}" Width="*"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Columna derecha: carrito -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Título "Carrito" -->
                    <RowDefinition Height="*"/>     <!-- DataGrid del carrito -->
                    <RowDefinition Height="Auto"/>  <!-- Label Método de pago -->
                    <RowDefinition Height="Auto"/>  <!-- ComboBox Método de pago -->
                    <RowDefinition Height="Auto"/>  <!-- Total -->
                    <RowDefinition Height="Auto"/>  <!-- Botón Cobrar -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Carrito" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Carrito}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="50"/>
                        <DataGridTextColumn Header="P.Unit" Binding="{Binding PrecioUnitario, StringFormat=C}" Width="80"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Separación clara entre carrito y controles de pago -->
                <TextBlock Grid.Row="2" Text="Método de pago:" Margin="0,12,0,3"/>
                <ComboBox Grid.Row="3" Margin="0,4,0,12"
                          ItemsSource="{Binding MetodosPago}"
                          SelectedItem="{Binding MetodoPagoSeleccionado}"
                          DisplayMemberPath="Nombre"
                          Padding="6" MinWidth="220"/>

                <TextBlock Grid.Row="4" Text="{Binding Total, StringFormat='Total: {0:C}'}"
                           FontSize="22" FontWeight="Bold" Margin="0,8,0,16" HorizontalAlignment="Right"/>

                <Button Grid.Row="5" Content="COBRAR" Command="{Binding CobrarCommand}" Style="{StaticResource BotonAccento}"
                        Height="56" FontSize="18" MinWidth="180" HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
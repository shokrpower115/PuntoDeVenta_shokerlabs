<UserControl x:Class="POS.UI.Views.VentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de acciones rápidas -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,24,0,24" HorizontalAlignment="Left" VerticalAlignment="Center" >
            <Button Content="Corte de Caja" Command="{Binding AbrirCorteCajaCommand}" Style="{StaticResource BotonPrimario}"
                    Height="54" FontSize="16" MinWidth="160" Padding="15,8" Margin="0,0,12,0"/>
            <Button Content="Retiro de Efectivo" Command="{Binding AbrirRetiroEfectivoCommand}" Style="{StaticResource BotonPrimario}"
                    Height="54" FontSize="16" MinWidth="160" Padding="15,8" Margin="0,0,12,0"/>
            <Button Content="Cancelación de Producto" Style="{StaticResource BotonPrimario}"
                    Height="54" FontSize="16" MinWidth="200" Padding="15,8" Margin="0,0,12,0" IsEnabled="False"/>
            <Button Content="Ver Inventario" Command="{Binding AbrirInventarioCommand}" Style="{StaticResource BotonPrimario}"
                     Height="54" FontSize="16" MinWidth="160" Padding="15,8" Margin="0,0,12,0"/>
        </StackPanel>

        <!-- Contenido de venta -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: buscador + catálogo de productos -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título "Productos" -->
                    <RowDefinition Height="Auto"/>
                    <!-- Buscador -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid de productos -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                    <RowDefinition Height="Auto"/>
                    <!-- Mensaje -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Productos" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBox Grid.Row="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" FontSize="14" Margin="0,0,0,10"
                         Tag="Buscar producto (nombre o código)..."/>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding ProductosDisponibles}"
                          SelectedItem="{Binding ProductoSeleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C}" Width="80"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockPorSucursal[0].Stock, FallbackValue=0}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Agregar al carrito" Command="{Binding AgregarAlCarritoCommand}" Style="{StaticResource BotonPrimario}"
                            Height="40" FontSize="14" Padding="10,6" Margin="0,0,10,0"/>
                    <Button Content="Ver en otras sucursales" Command="{Binding ConsultarOtrasSucursalesCommand}" Style="{StaticResource BotonPrimario}"
                            Height="40" FontSize="14" Padding="10,6"/>
                </StackPanel>

                <TextBlock Grid.Row="4" Text="{Binding Mensaje}" Foreground="DarkOrange" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </Grid>

            <!-- Columna derecha: carrito / ticket en vivo -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título "Carrito" -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid del carrito -->
                    <RowDefinition Height="Auto"/>
                    <!-- Label Método de pago -->
                    <RowDefinition Height="Auto"/>
                    <!-- ComboBox Método de pago -->
                    <RowDefinition Height="Auto"/>
                    <!-- Total -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botón Cobrar -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Carrito" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Carrito}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Cantidad" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="−" Width="28" Height="28"
                                                Command="{Binding DataContext.DisminuirCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Cantidad}" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Content="+" Width="28" Height="28"
                                                Command="{Binding DataContext.AumentarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Descripción" Binding="{Binding NombreProducto}" Width="*"/>

                        <DataGridTextColumn Header="Total" Binding="{Binding Subtotal, StringFormat=C}" Width="80"/>

                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Width="28" Height="28" Foreground="{StaticResource BrushRojoPrimario}"
                                            Command="{Binding DataContext.EliminarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="4" Text="{Binding Total, StringFormat='Total: {0:C}'}"
                           FontSize="22" FontWeight="Bold" Margin="0,8,0,16" HorizontalAlignment="Right"/>

                <Button Grid.Row="5" Content="COBRAR" Command="{Binding CobrarCommand}" Style="{StaticResource BotonAccento}"
                        Height="56" FontSize="18" MinWidth="180" HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
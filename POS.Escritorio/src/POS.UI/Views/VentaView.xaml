<UserControl x:Class="POS.UI.Views.VentaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Atajos de caja (ver docs/guia-de-estilo-ui.md): F2 buscar, F12 cobrar. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CobrarCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Encabezado + acciones de caja ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Venta" Style="{StaticResource TextoTitulo}"/>
                <TextBlock Text="Escanea o busca un producto y presiona Enter para agregarlo." Style="{StaticResource TextoSecundario}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding AbrirInventarioCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE7B8;" Margin="0,0,8,0"/>
                        <TextBlock Text="Inventario"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AbrirRetiroEfectivoCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE8AB;" Margin="0,0,8,0"/>
                        <TextBlock Text="Entrada / retiro"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AbrirCorteCajaCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE8EF;" Margin="0,0,8,0"/>
                        <TextBlock Text="Corte de caja"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Catálogo ===== -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Buscador -->
                    <Grid Grid.Row="0" Margin="20,20,20,16">
                        <TextBox x:Name="TxtBusqueda" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Buscar por nombre o código de barras   (F2)" FontSize="16" MinHeight="48" Padding="40,0,10,0">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AgregarDesdeBusquedaCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Style="{StaticResource Icono}" Text="&#xE721;" Foreground="{StaticResource BrushTextoTenue}"
                                   HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProductosDisponibles}" SelectedItem="{Binding ProductoSeleccionado}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AgregarAlCarritoCommand}"/>
                            <KeyBinding Key="Enter" Command="{Binding AgregarAlCarritoCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoBarras}" Width="140"/>
                            <DataGridTextColumn Header="PRECIO" Binding="{Binding Precio, StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="STOCK" Binding="{Binding StockPorSucursal[0].Stock, FallbackValue=0}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Acciones sobre el producto seleccionado + avisos -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,1,0,0" Padding="20,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding AgregarAlCarritoCommand}" Style="{StaticResource BotonPrimario}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icono}" Text="&#xE710;" Margin="0,0,8,0" FontSize="13"/>
                                        <TextBlock Text="Agregar al carrito"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ConsultarOtrasSucursalesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icono}" Text="&#xE774;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Otras sucursales"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Style="{StaticResource AvisoAdvertencia}" Margin="0,12,0,0"
                                    Visibility="{Binding Mensaje, Converter={StaticResource TextoNoVacioAVisibilidad}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icono}" Text="&#xE7BA;" Foreground="{StaticResource BrushAdvertencia}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource BrushAdvertencia}" TextWrapping="Wrap" MaxWidth="560"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AvisoExito}" Margin="0,12,0,0"
                                    Visibility="{Binding MensajeExito, Converter={StaticResource TextoNoVacioAVisibilidad}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icono}" Text="&#xE73E;" Foreground="{StaticResource BrushExito}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding MensajeExito}" Foreground="{StaticResource BrushExito}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Ticket en curso ===== -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,20,20,12">
                        <TextBlock Text="Ticket actual" Style="{StaticResource TextoSubtitulo}"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TextoSecundario}">
                            <Run Text="{Binding ArticulosEnCarrito, Mode=OneWay}"/><Run Text=" artículos"/>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Carrito}" BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,0,0,1" Padding="20,10">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding NombreProducto}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat=C}" FontWeight="SemiBold"/>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="&#xE738;" Style="{StaticResource BotonIcono}" ToolTip="Quitar uno"
                                                    Command="{Binding DataContext.DisminuirCantidadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Cantidad}" Width="40" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <Button Content="&#xE710;" Style="{StaticResource BotonIcono}" ToolTip="Agregar uno"
                                                    Command="{Binding DataContext.AumentarCantidadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding PrecioUnitario, StringFormat='× {0:C}'}" Style="{StaticResource TextoSecundario}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Row="1" Grid.Column="1" Content="&#xE74D;" Style="{StaticResource BotonIcono}"
                                                Foreground="{StaticResource BrushPeligro}" BorderThickness="0" Margin="0,8,0,0" ToolTip="Quitar del ticket"
                                                Command="{Binding DataContext.EliminarDelCarritoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Estado vacío -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Carrito.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE7BF;" FontSize="40" Foreground="{StaticResource BrushBordeFuerte}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="El ticket está vacío" Style="{StaticResource TextoSecundario}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Total + cobrar -->
                    <Border Grid.Row="2" Background="{StaticResource BrushSuperficieAlt}" BorderBrush="{StaticResource BrushBorde}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Total" Style="{StaticResource TextoSubtitulo}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Total, StringFormat=C}" Style="{StaticResource TextoMonto}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button Command="{Binding CobrarCommand}" Style="{StaticResource BotonExito}" Height="58" FontSize="18">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cobrar"/>
                                    <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="F12" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

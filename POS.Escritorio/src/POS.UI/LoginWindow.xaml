<Window x:Class="POS.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión" Height="320" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="30" VerticalAlignment="Center" Background="{StaticResource BrushFondo}">
        <TextBlock Text="Punto de Venta" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushAzulPrimario}"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Usuario:" Margin="0,0,0,5"/>
        <TextBox Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6" Margin="0,0,0,15"/>

        <TextBlock Text="Contraseña:" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox" Padding="6" Margin="0,0,0,15"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <Button Content="Iniciar sesión" Command="{Binding IniciarSesionCommand}" Style="{StaticResource BotonAccento}"
                Height="40"/>

        <TextBlock Text="{Binding MensajeError}" Foreground="{StaticResource BrushRojoPrimario}" Margin="0,15,0,0"
                   TextWrapping="Wrap" HorizontalAlignment="Center"/>

        <TextBlock Text="Prueba: centro / norte / sur — contraseña: 1234"
                   FontSize="11" Foreground="Gray" Margin="0,20,0,0"
                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
</Window>

<Window x:Class="POS.UI.InventarioConsultaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventario" Width="760" Height="640"
        WindowStartupLocation="CenterOwner" Style="{StaticResource VentanaBase}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Inventario de la sucursal" Style="{StaticResource TextoTitulo}"/>
                <TextBlock Text="Existencias actuales de esta sucursal. Solo consulta." Style="{StaticResource TextoSecundario}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Command="{Binding RecargarCommand}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icono}" Text="&#xE72C;" Margin="0,0,8,0"/>
                    <TextBlock Text="Actualizar"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid ItemsSource="{Binding Productos}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoBarras}" Width="150"/>
                    <DataGridTextColumn Header="PRECIO" Binding="{Binding Precio, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="STOCK" Binding="{Binding StockPorSucursal[0].Stock, FallbackValue=0}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>

<Window x:Class="POS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NombreNegocio}" Height="720" Width="1200" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Style="{StaticResource VentanaBase}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Menú lateral ===== -->
        <Grid Grid.Column="0" Background="{StaticResource BrushMenu}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Marca del negocio: logo o iniciales -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,24,16,28">
                <Grid Width="44" Height="44">
                    <Border Style="{StaticResource InsigniaNegocio}" Visibility="{DynamicResource VisibilidadIniciales}">
                        <TextBlock Text="{DynamicResource InicialesNegocio}" Foreground="{DynamicResource BrushPrimarioTexto}"
                                   FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="10" Background="White" Visibility="{DynamicResource VisibilidadLogo}">
                        <Image Source="{DynamicResource LogoNegocio}" Margin="4" Stretch="Uniform"/>
                    </Border>
                </Grid>
                <TextBlock Text="{DynamicResource NombreNegocio}" Foreground="{StaticResource BrushTextoInverso}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                           TextWrapping="Wrap" MaxWidth="140"/>
            </StackPanel>

            <!-- Navegación -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="MENÚ" Foreground="{StaticResource BrushTextoSecundario}" FontSize="11" FontWeight="SemiBold"
                           Margin="30,0,0,8"/>
                <RadioButton Content="Venta" Tag="&#xE7BF;" GroupName="Menu" IsChecked="{Binding EnVenta, Mode=OneWay}"
                             Style="{StaticResource ItemMenu}" Command="{Binding IrAVentaCommand}"/>
                <RadioButton Content="Administrador" Tag="&#xE713;" GroupName="Menu" IsChecked="{Binding EnAdministrador, Mode=OneWay}"
                             Style="{StaticResource ItemMenu}" Command="{Binding IrAAdministradorCommand}"
                             Visibility="{Binding EsAdministrador, Converter={StaticResource BooleanoAVisibilidadConverter}}"/>
            </StackPanel>

            <!-- Usuario en sesión + cerrar sesión -->
            <Border Grid.Row="2" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0" Padding="20,16,16,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#33FFFFFF">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE77B;" Foreground="{StaticResource BrushTextoInverso}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NombreUsuarioActual}" Foreground="{StaticResource BrushTextoInverso}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            <TextBlock Foreground="{StaticResource BrushMenuTexto}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="140">
                                <Run Text="{Binding PuestoActual, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding NombreSucursal, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Button Command="{Binding CerrarSesionCommand}" Style="{StaticResource BotonFantasma}"
                            Foreground="{StaticResource BrushMenuTexto}" HorizontalContentAlignment="Left" Margin="-10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icono}" Text="&#xE7E8;" Margin="0,0,12,0"/>
                            <TextBlock Text="Cerrar sesión"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Área de contenido: aquí se inyecta la pantalla actual ===== -->
        <ContentControl Grid.Column="1" Content="{Binding PantallaActual}" Margin="28,24"/>
    </Grid>
</Window>

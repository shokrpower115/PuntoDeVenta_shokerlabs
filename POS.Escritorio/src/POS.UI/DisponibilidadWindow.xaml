<Window x:Class="POS.UI.DisponibilidadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disponibilidad en otras sucursales" Width="480" Height="420"
        WindowStartupLocation="CenterOwner" Style="{StaticResource VentanaBase}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Otras sucursales" Style="{StaticResource TextoTitulo}"/>
            <TextBlock Text="{Binding NombreProductoConsultado, StringFormat='Existencias de «{0}»'}" Style="{StaticResource TextoSecundario}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid ItemsSource="{Binding DisponibilidadOtrasSucursales}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SUCURSAL" Binding="{Binding NombreSucursal}" Width="*"/>
                    <DataGridTextColumn Header="STOCK" Binding="{Binding Stock}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
